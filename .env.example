# Public URL of the site, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://orvexco.com

# Resend API key (https://resend.com). Required in production: without it, the
# inquiry form shows an error rather than pretending the inquiry was sent.
# In development, inquiries are logged to the terminal instead.
RESEND_API_KEY=

# Where inquiries are sent, and who they are sent from. The "from" domain must
# be verified in Resend. Both are optional; these are the defaults.
INQUIRY_TO=inquiries@orvexco.com
INQUIRY_FROM=Orvex Website <website@orvexco.com>
